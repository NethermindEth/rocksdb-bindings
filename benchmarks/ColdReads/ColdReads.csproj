<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The bindings tree to build against: one checkout per arm. HAS_PREFETCH when it has PrefetchAsync. -->
    <BindingsDir Condition="'$(BindingsDir)' == ''">../..</BindingsDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(BindingsDir)/src/Nethermind.RocksDbBindings/Nethermind.RocksDbBindings.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Nethermind.RocksDbBindings/**/*.cs" Exclude="../Nethermind.RocksDbBindings/**/obj/**;../Nethermind.RocksDbBindings/**/bin/**" />
    <Compile Include="../../benchmarks/NativeMultiGet/References/*.cs" />
    <InternalsVisibleTo Include="NativeMultiGet" />
  </ItemGroup>


  <ItemGroup>
    <InternalsVisibleTo Include="Nethermind.RocksDbBindings.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <Description>C# bindings for RocksDB.</Description>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <PackageId>Nethermind.RocksDbBindings</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nethermindeth/rocksdb-bindings</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>rocksdb</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/nethermindeth/rocksdb-bindings</RepositoryUrl>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="../Nethermind.RocksDbBindings/runtimes/linux-arm64/native/librocksdb.so" Link="runtimes/linux-arm64/native/librocksdb.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="../Nethermind.RocksDbBindings/runtimes/linux-x64/native/librocksdb.so" Link="runtimes/linux-x64/native/librocksdb.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="../Nethermind.RocksDbBindings/runtimes/osx-arm64/native/librocksdb.dylib" Link="runtimes/osx-arm64/native/librocksdb.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="../Nethermind.RocksDbBindings/runtimes/osx-x64/native/librocksdb.dylib" Link="runtimes/osx-x64/native/librocksdb.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="../Nethermind.RocksDbBindings/runtimes/win-arm64/native/rocksdb.dll" Link="runtimes/win-arm64/native/rocksdb.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="../Nethermind.RocksDbBindings/runtimes/win-x64/native/rocksdb.dll" Link="runtimes/win-x64/native/rocksdb.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>%(RelativeDir)%(Filename)%(Extension)</PackagePath>
    </None>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES" Pack="true" PackagePath="/" />
  </ItemGroup>


</Project>
